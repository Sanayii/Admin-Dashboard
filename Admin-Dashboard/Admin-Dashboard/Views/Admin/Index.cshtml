@model IEnumerable<Admin_Dashboard.Models.Admin>

@{
    ViewData["Title"] = "Admins Management";
    ViewBag.pagename = "Admins";
}

<style>
    .admin-table th {
        white-space: nowrap;
    }

    .salary-cell {
        font-weight: 500;
    }

    .status-badge {
        padding: 0.35em 0.65em;
        font-size: 0.75em;
    }
</style>

<partial name="_Banner" />

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Admins Management</h2>
        <div>
            <a class="btn btn-outline-secondary me-2" asp-action="GetAllAdmins" asp-controller="Admin">
                <i class="bi bi-archive me-1"></i>All Statuses
            </a>
            <a class="btn btn-primary" asp-controller="Admin" asp-action="Create">
                <i class="bi bi-person-plus me-1"></i>New Admin
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 admin-table">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Admin</th>
                            <th>Salary</th>
                            <th>Details</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle">#@item.Id</td>
                                <td class="align-middle">
                                    <div class="fw-semibold">@item.IdNavigation?.FName @item.IdNavigation?.LName</div>
                                    <small class="text-muted">@item.IdNavigation?.Email</small>
                                </td>
                                <td class="align-middle salary-cell">
                                    @item.Salary.ToString("C")
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex flex-column">
                                        <span>Age: @item.IdNavigation?.Age</span>
                                        <div class="mt-1">
                                            @if (item.IdNavigation?.UserPhones != null && item.IdNavigation.UserPhones.Any())
                                            {
                                                foreach (var phone in item.IdNavigation.UserPhones.Take(2))
                                                {
                                                    <span class="badge bg-light text-dark border me-1">@phone.PhoneNumber</span>
                                                }
                                                @if (item.IdNavigation.UserPhones.Count > 2)
                                                {
                                                    <span class="badge bg-light text-muted border">+@(item.IdNavigation.UserPhones.Count - 2)</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">No phones</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="align-middle">
                                    @if (item.IdNavigation?.IsDeleted == true)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger status-badge">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success status-badge">Active</span>
                                    }
                                </td>
                                <td class="align-middle text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-controller="Admin" asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary d-flex align-items-center">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </a>
                                        <form asp-action="Delete" asp-controller="Admin" method="post">
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger d-flex align-items-center"
                                                    onclick="return confirm('Delete this admin?')">
                                                <i class="bi bi-trash me-1"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>