@model Admin_Dashboard.Models.CustomerDiscount

@{
    ViewData["Title"] = "Edit";
    ViewBag.pagename = "Contract";
}

<style>
    input {
        width: 60%;
    }

        input[type=file] {
            background-color: #fff;
            border: 1px solid #d2cbcb;
            border-radius: 3px;
            color: black;
        }
</style>
<partial name="_Banner" />
<section class="container" style="margin-top: 3%; margin-bottom: 3%;">
    <div class="form">

        <form method="post" asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CustomerId" />
            <input type="hidden" asp-for="DiscountId" />
            <div class="form-group">
                <label asp-for="DateGiven" class="control-label"></label>
                <input asp-for="DateGiven" class="form-control" />
                <span asp-validation-for="DateGiven" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary"
                    style="text-align:center;background-color:#262e39;
                    color:#fff;width: 119px;height: 50px;margin-bottom:30px">
                Save
            </button>
        </form>

    </div>

    <div>
        <a asp-action="Index">Back to List</a>
    </div>

</section>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>