@model List<Admin_Dashboard.Models.Customer>

@{
    ViewData["Title"] = "Customers Management";
    ViewBag.pagename = "Customers";
}

<style>
    .action-buttons .btn {
        min-width: 90px;
    }

    .customer-name {
        font-weight: 500;
    }
</style>

<partial name="_Banner" />

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Customers Management</h2>
        <div>
            <a class="btn btn-outline-secondary me-2" asp-action="GetAllCustomers" asp-controller="Customer">
                <i class="bi bi-archive me-1"></i>All Statuses
            </a>
            <a class="btn btn-primary" asp-action="Create" asp-controller="Customer">
                <i class="bi bi-person-plus me-1"></i>New Customer
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Customer</th>
                            <th>Contact</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td class="align-middle">#@customer.Id</td>
                                <td class="align-middle">
                                    <div class="customer-name">@customer.FName @customer.LName</div>
                                    @if (customer.Age.HasValue)
                                    {
                                        <small class="text-muted">Age: @customer.Age</small>
                                    }
                                </td>
                                <td class="align-middle">
                                    <div>@customer.Email</div>
                                    <div class="mt-1">
                                        @if (customer.UserPhones != null && customer.UserPhones.Any())
                                        {
                                            foreach (var phone in customer.UserPhones.Take(2))
                                            {
                                                <span class="badge bg-light text-dark border me-1">@phone.PhoneNumber</span>
                                            }
                                            @if (customer.UserPhones.Count > 2)
                                            {
                                                <span class="badge bg-light text-muted border">+@(customer.UserPhones.Count - 2)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">No phones</span>
                                        }
                                    </div>
                                </td>
                                <td class="align-middle">
                                    <span class="badge bg-light text-dark border">@customer.City</span>
                                </td>
                                <td class="align-middle">
                                    @if (customer.IsDeleted)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                                    }
                                </td>
                                <td class="align-middle text-end">
                                    <div class="action-buttons d-flex justify-content-end gap-2">
                                        <a asp-action="Edit" asp-route-id="@customer.Id"
                                           class="btn btn-sm btn-outline-primary d-flex align-items-center">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@customer.Id" method="post">
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger d-flex align-items-center"
                                                    onclick="return confirm('Delete this customer?')">
                                                <i class="bi bi-trash me-1"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>