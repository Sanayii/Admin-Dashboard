@model List<Admin_Dashboard.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<h2>All Customers</h2>

<table class="table">
    <thead>
        <tr>
            <th>Customer ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>City</th>
            <th>Phone Numbers</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            <tr>
                <td>@customer.Id</td>
                <td>@customer.FName @customer.LName</td>
                <td>@customer.Email</td>
                <td>@customer.City</td>
                <td>
                    @foreach (var phone in customer.UserPhones)
                    {
                        <span>@phone.PhoneNumber</span>

                        <br />
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@customer.Id">Edit</a>

                    <form asp-action="Delete" asp-route-id="@customer.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this customer?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>

            </tr>
        }
    </tbody>
</table>
