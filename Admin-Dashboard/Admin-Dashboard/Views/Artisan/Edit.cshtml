@model Admin_Dashboard.Models.ArtisanUserViewModel

@{
    ViewData["Title"] = "Edit Artisan";
    ViewBag.pagename = "Artisan";
}

<partial name="_Banner" />

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Edit Artisan</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <!-- User Info -->
                    <div class="col-md-6">
                        <h4 class="text-secondary">User Information</h4>

                        <div class="mb-3">
                            <label asp-for="User.FName" class="form-label"></label>
                            <input asp-for="User.FName" class="form-control" />
                            <span asp-validation-for="User.FName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="User.LName" class="form-label"></label>
                            <input asp-for="User.LName" class="form-control" />
                            <span asp-validation-for="User.LName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="User.Email" class="form-label"></label>
                            <input asp-for="User.Email" class="form-control" />
                            <span asp-validation-for="User.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="User.PhoneNumber" class="form-label"></label>
                            <input asp-for="User.PhoneNumber" class="form-control" />
                            <span asp-validation-for="User.PhoneNumber" class="text-danger"></span>
                        </div>

                        <h5 class="mt-4 text-secondary">Additional Phone Numbers</h5>
                        @{
                            var phoneList = Model.User.UserPhones.ToList();
                            for (int i = 0; i < phoneList.Count; i++)
                            {
                                <div class="mb-3">
                                    <label class="form-label">Phone @(i + 1)</label>
                                    <input asp-for="User.UserPhones.ElementAt(i).PhoneNumber" class="form-control" />
                                    <span asp-validation-for="User.UserPhones.ElementAt(i).PhoneNumber" class="text-danger"></span>
                                    <input type="hidden" asp-for="User.UserPhones.ElementAt(i).UserId" />
                                </div>
                            }
                        }
                    </div>

                    <!-- Artisan Info -->
                    <div class="col-md-6">
                        <h4 class="text-secondary">Artisan Information</h4>

                        <div class="mb-3">
                            <label asp-for="Artisan.NationalityId" class="form-label"></label>
                            <input asp-for="Artisan.NationalityId" class="form-control" />
                            <span asp-validation-for="Artisan.NationalityId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Artisan.Rating" class="form-label"></label>
                            <input asp-for="Artisan.Rating" class="form-control" />
                            <span asp-validation-for="Artisan.Rating" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Artisan.CategoryId" class="form-label"></label>
                            <select asp-for="Artisan.CategoryId" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                            </select>
                            <span asp-validation-for="Artisan.CategoryId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
