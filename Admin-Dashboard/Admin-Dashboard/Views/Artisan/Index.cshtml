@model IEnumerable<Admin_Dashboard.Models.Artisan>

@{
    ViewData["Title"] = "Artisans";
}

<h1>Artisans</h1>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Category</th>
            <th>Rating</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdNavigation.FName @item.IdNavigation.LName</td>
                <td>@item.IdNavigation.Email</td>
                <td>
                    @if (item.IdNavigation.UserPhones.Any())
                    {
                        @item.IdNavigation.UserPhones.First().PhoneNumber
                    }
                </td>
                <td>@item.Category?.Name</td>
                <td>@item.Rating</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
                    <form asp-action="Delete" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>