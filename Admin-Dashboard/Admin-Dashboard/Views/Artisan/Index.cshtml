@model IEnumerable<Admin_Dashboard.Models.Artisan>

@{
    ViewData["Title"] = "Artisans List";
    ViewBag.pagename = "Artisans";
}

<style>
    .rating {
        font-size: 1.2rem;
        letter-spacing: 0.1rem;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

        .rating i {
            cursor: default;
        }

    .rating-value {
        font-size: 0.9rem;
        margin-left: 0.5rem;
        color: #6c757d;
    }

    .action-buttons .btn {
        min-width: 80px;
    }
</style>

<partial name="_Banner" />

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Artisans Management</h2>
        <div>
            <a asp-action="GetAllArtisans" class="btn btn-outline-secondary me-2">
                <i class="bi bi-people-fill"></i>  All Artisans
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus"></i> Add New Artisan
            </a>
        </div>
    </div>


    <!-- Add the search form here -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-3">
            <form asp-action="Search" method="get" class="row g-3 align-items-center">
                <div class="col-md-6 search-container">
                    <div class="input-group">
                        <input type="text" name="searchTerm" class="form-control"
                               placeholder="Search by name..." value="@Context.Request.Query["searchTerm"]" />
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                        @if (!string.IsNullOrEmpty(Context.Request.Query["searchTerm"]))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg"></i> Clear
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>


    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Rating</th>
                            <th>Contact</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var artisan in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@artisan.FName @artisan.LName</div>
                                    <small class="text-muted">@artisan.Email</small>
                                </td>
                                <td>
                                    <span class="badge bg-primary">@artisan.Category?.Name</span>
                                </td>
                                <td>
                                    <div class="rating" data-rating="@artisan.Rating">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="bi @(i <= artisan.Rating ? "bi-star-fill text-warning" : "bi-star text-secondary")"></i>
                                        }
                                        <span class="rating-value">@artisan.Rating.ToString("0.0")</span>
                                    </div>
                                </td>
                                <td>
                                    @if (artisan.UserPhones != null && artisan.UserPhones.Any())
                                    {
                                        foreach (var phone in artisan.UserPhones.Take(2))
                                        {
                                            <span class="badge bg-info text-dark me-1 mb-1">@phone.PhoneNumber</span>
                                        }
                                        @if (artisan.UserPhones.Count > 2)
                                        {
                                            <span class="badge bg-secondary">+@(artisan.UserPhones.Count - 2) more</span>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (artisan.IsDeleted)
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>
                                <td class="action-buttons">
                                    <div class="d-flex gap-2">
                                        <a asp-action="Edit" asp-route-id="@artisan.Id"
                                           class="btn btn-sm btn-outline-primary flex-grow-1">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </a>
                                        <form asp-action="Delete" method="post" class="flex-grow-1">
                                            <input type="hidden" name="id" value="@artisan.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100"
                                                    onclick="return confirm('Are you sure you want to delete this artisan?')">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>